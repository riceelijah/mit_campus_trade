# Copy to .env and fill in real values for local development.
# In production, these must be set as real environment variables (not via a .env file
# committed anywhere) -- see README.md for deployment notes.

# Port the Express API listens on. Defaults to 3001 if unset.
PORT=3001

# Signs the session cookie. MUST be set to a long random value in production -- if unset,
# the server refuses to start when NODE_ENV=production (see server/auth/session.ts).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The email address that is automatically granted admin privileges on registration.
# Defaults to ejrice@mit.edu if unset. Must be lowercase.
ADMIN_EMAIL=

# Set to "production" in production. Enables the `secure` flag on the session cookie
# (requires HTTPS) and enforces SESSION_SECRET being set.
NODE_ENV=development
